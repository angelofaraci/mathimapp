import com.example.proyectofinal.models.UserRole;
import com.example.proyectofinal.models.ExerciseType;
import kotlin.Boolean;
import kotlin.Int;

-- User table
CREATE TABLE UserEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    role TEXT AS UserRole NOT NULL DEFAULT 'STUDENT'
);

-- Queries for Users
selectUserById:
SELECT * FROM UserEntity WHERE id = ?;

insertUser:
INSERT OR REPLACE INTO UserEntity(id, name, email, role)
VALUES (?, ?, ?, ?);

-- Course table
CREATE TABLE CourseEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    creatorId TEXT NOT NULL,
    isOfficial INTEGER AS Boolean NOT NULL DEFAULT 0,
    schoolYear INTEGER AS Int NOT NULL DEFAULT 0,
    joinCode TEXT,
    topic TEXT,
    difficulty TEXT,
    durationMinutes INTEGER AS Int,
    xpReward INTEGER AS Int
);

-- Lesson table
CREATE TABLE LessonEntity (
    id TEXT NOT NULL PRIMARY KEY,
    courseId TEXT,
    creatorId TEXT,
    title TEXT NOT NULL,
    theoryContent TEXT NOT NULL,
    FOREIGN KEY(courseId) REFERENCES CourseEntity(id) ON DELETE CASCADE
);

-- Exercise table
CREATE TABLE ExerciseEntity (
    id TEXT NOT NULL PRIMARY KEY,
    lessonId TEXT NOT NULL,
    title TEXT NOT NULL,
    type TEXT AS ExerciseType NOT NULL DEFAULT 'MULTIPLE_CHOICE',
    payload TEXT NOT NULL,
    FOREIGN KEY(lessonId) REFERENCES LessonEntity(id) ON DELETE CASCADE
);

-- UserProgress table
CREATE TABLE UserProgressEntity (
    userId TEXT NOT NULL PRIMARY KEY,
    totalScore INTEGER AS Int NOT NULL DEFAULT 0,
    activityStreak INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(userId) REFERENCES UserEntity(id) ON DELETE CASCADE
);

-- Learner profile table
CREATE TABLE LearnerProfileEntity (
    userId TEXT NOT NULL PRIMARY KEY,
    province TEXT NOT NULL,
    schoolYear INTEGER NOT NULL,
    studentTrack TEXT NOT NULL,
    onboardingComplete INTEGER AS Boolean NOT NULL DEFAULT 0
);

-- Many-to-Many: Completed Lessons
CREATE TABLE CompletedLesson (
    userId TEXT NOT NULL,
    lessonId TEXT NOT NULL,
    PRIMARY KEY(userId, lessonId),
    FOREIGN KEY(userId) REFERENCES UserEntity(id) ON DELETE CASCADE,
    FOREIGN KEY(lessonId) REFERENCES LessonEntity(id) ON DELETE CASCADE
);

-- Many-to-Many: Completed Exercises
CREATE TABLE CompletedExercise (
    userId TEXT NOT NULL,
    exerciseId TEXT NOT NULL,
    PRIMARY KEY(userId, exerciseId),
    FOREIGN KEY(userId) REFERENCES UserEntity(id) ON DELETE CASCADE,
    FOREIGN KEY(exerciseId) REFERENCES ExerciseEntity(id) ON DELETE CASCADE
);

-- Many-to-Many: Enrolled Courses
CREATE TABLE EnrolledCourse (
    userId TEXT NOT NULL,
    courseId TEXT NOT NULL,
    PRIMARY KEY(userId, courseId),
    FOREIGN KEY(userId) REFERENCES UserEntity(id) ON DELETE CASCADE,
    FOREIGN KEY(courseId) REFERENCES CourseEntity(id) ON DELETE CASCADE
);

-- Queries for Courses
selectAllCourses:
SELECT * FROM CourseEntity;

selectCourseById:
SELECT * FROM CourseEntity WHERE id = ?;

selectCoursesByCreatorId:
SELECT * FROM CourseEntity WHERE creatorId = ?;

insertCourse:
INSERT OR REPLACE INTO CourseEntity(id, title, description, creatorId, isOfficial, schoolYear, joinCode, topic, difficulty, durationMinutes, xpReward)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCourse:
DELETE FROM CourseEntity WHERE id = ?;

-- Queries for Lessons
selectLessonsByCourseId:
SELECT * FROM LessonEntity WHERE courseId = ?;

selectLessonById:
SELECT * FROM LessonEntity WHERE id = ?;

insertLesson:
INSERT OR REPLACE INTO LessonEntity(id, courseId, creatorId, title, theoryContent)
VALUES (?, ?, ?, ?, ?);

deleteLesson:
DELETE FROM LessonEntity WHERE id = ?;

-- Queries for Exercises
selectExercisesByLessonId:
SELECT * FROM ExerciseEntity WHERE lessonId = ?;

selectExerciseById:
SELECT * FROM ExerciseEntity WHERE id = ?;

insertExercise:
INSERT OR REPLACE INTO ExerciseEntity(id, lessonId, title, type, payload)
VALUES (?, ?, ?, ?, ?);

deleteExercise:
DELETE FROM ExerciseEntity WHERE id = ?;

-- Queries for Progress
selectProgressByUserId:
SELECT * FROM UserProgressEntity WHERE userId = ?;

insertProgress:
INSERT OR REPLACE INTO UserProgressEntity(userId, totalScore, activityStreak)
VALUES (?, ?, ?);

selectProfile:
SELECT province, schoolYear, studentTrack, onboardingComplete
FROM LearnerProfileEntity
WHERE userId = ?;

upsertProfile:
INSERT OR REPLACE INTO LearnerProfileEntity(userId, province, schoolYear, studentTrack, onboardingComplete)
VALUES (?, ?, ?, ?, ?);

clearProfile:
DELETE FROM LearnerProfileEntity WHERE userId = ?;

selectCompletedLessonsByUserId:
SELECT lessonId FROM CompletedLesson WHERE userId = ?;

insertCompletedLesson:
INSERT OR REPLACE INTO CompletedLesson(userId, lessonId)
VALUES (?, ?);

selectCompletedExercisesByUserId:
SELECT exerciseId FROM CompletedExercise WHERE userId = ?;

insertCompletedExercise:
INSERT OR REPLACE INTO CompletedExercise(userId, exerciseId)
VALUES (?, ?);

selectEnrolledCoursesByUserId:
SELECT courseId FROM EnrolledCourse WHERE userId = ?;

insertEnrolledCourse:
INSERT OR REPLACE INTO EnrolledCourse(userId, courseId)
VALUES (?, ?);

-- Learning path catalog is read-only cache of platform-curated paths.
CREATE TABLE LearningPathEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    visibleObjective TEXT NOT NULL,
    objectiveType TEXT NOT NULL,
    objectiveGradeLevel INTEGER NOT NULL,
    lessonCount INTEGER NOT NULL,
    completedLessonCount INTEGER NOT NULL,
    progressPercentage INTEGER NOT NULL,
    isDefaultForObjective INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE TABLE LearningPathLessonEntity (
    pathId TEXT NOT NULL,
    lessonId TEXT NOT NULL,
    title TEXT NOT NULL,
    orderIndex INTEGER NOT NULL,
    completed INTEGER AS Boolean NOT NULL DEFAULT 0,
    PRIMARY KEY(pathId, lessonId),
    FOREIGN KEY(pathId) REFERENCES LearningPathEntity(id) ON DELETE CASCADE
);

-- State remains server-authoritative and is cached per authenticated account only.
CREATE TABLE LearningPathStateEntity (
    userId TEXT NOT NULL PRIMARY KEY,
    recommendedPathId TEXT,
    selectedPathId TEXT,
    lastOpenedPathId TEXT
);

selectLearningPathById:
SELECT * FROM LearningPathEntity WHERE id = ?;

selectLearningPathsByGradeLevel:
SELECT * FROM LearningPathEntity
WHERE objectiveGradeLevel = ?
ORDER BY name;

selectLearningPathLessons:
SELECT * FROM LearningPathLessonEntity
WHERE pathId = ?
ORDER BY orderIndex;

selectLearningPathState:
SELECT * FROM LearningPathStateEntity WHERE userId = ?;

insertLearningPath:
INSERT OR REPLACE INTO LearningPathEntity(
    id, name, description, visibleObjective, objectiveType, objectiveGradeLevel,
    lessonCount, completedLessonCount, progressPercentage, isDefaultForObjective
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertLearningPathLesson:
INSERT OR REPLACE INTO LearningPathLessonEntity(pathId, lessonId, title, orderIndex, completed)
VALUES (?, ?, ?, ?, ?);

insertLearningPathState:
INSERT OR REPLACE INTO LearningPathStateEntity(userId, recommendedPathId, selectedPathId, lastOpenedPathId)
VALUES (?, ?, ?, ?);

deleteAllLearningPaths:
DELETE FROM LearningPathEntity;

deleteLearningPathsByGradeLevel:
DELETE FROM LearningPathEntity WHERE objectiveGradeLevel = ?;

deleteLearningPathLessons:
DELETE FROM LearningPathLessonEntity WHERE pathId = ?;
